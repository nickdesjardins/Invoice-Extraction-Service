# --- Provider credentials -------------------------------------------------
# OpenRouter is the only vendor this service talks to. https://openrouter.ai/keys
# Leave blank to disable the service; /health then reports "unavailable".
# Free model endpoints may keep and train on what you send them: use the sample
# documents or redacted ones, not real invoices (README, "Data handling").
OPENROUTER_API_KEY=

# --- Model chain ----------------------------------------------------------
# Ordered, comma-separated. The first entry is the primary; each later entry is
# tried only when the earlier ones fail.
# Leave this blank to let the service look after the chain itself. It starts from
# the tested default in app/config.py, which is all :free, so a request costs
# nothing. Free models are withdrawn often. When a model of the chain stops
# answering and OpenRouter no longer offers it, the service tests the free models
# on offer with seven sample documents and gives the free place to one that
# passes. Such a test spends free requests of your daily allowance, never money.
# When the service starts, it also reads the published list: the chain that this
# project's scheduled test published, one small file on GitHub, read without a key.
# Name models here to fix the chain: the service then calls exactly those, and
# never tests or replaces one. Blank means nothing after the equals sign: a
# comment there would be read as a model id, and with the word null the service
# does not start.
# How the default was measured: README, "Model selection". How the published
# list is made: README, "The scheduled test".
OPENROUTER_MODELS=
# null = never read the published list; leave the line out to read this project's own.
# Any other value has to be an https address. A value such as off or false is not
# used, and the log says so in a WARNING.
# MODEL_PUBLISHED_URL=null
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# true  = strict json_schema response_format (needs a structured-output model)
# false = plain JSON mode with the schema embedded in the system prompt. The
#         published list was made with true, so the service does not use it then.
OPENROUTER_STRICT_JSON_SCHEMA=true
MAX_OUTPUT_TOKENS=2048

# --- Service --------------------------------------------------------------
# Name reported by /health, shown at the foot of the page and written in the log
SERVICE_NAME=invoice-extraction-service
# development | staging | production | test
# (production also hides /docs, switches the page's test-suite button off, and makes
# the playground page's POST routes refuse callers that are not a browser, such as
# curl or a script)
ENVIRONMENT=development
# Per-model wall-clock budget in seconds.
# Worst case latency ~= TIMEOUT_SECONDS x number of models in the chain.
TIMEOUT_SECONDS=30
# DEBUG | INFO | WARNING | ERROR
# (DEBUG also writes the vendor name and the invoice number of each extraction to
# the log, and the figures of a line whose total was corrected, so keep INFO
# wherever other people's documents arrive)
LOG_LEVEL=INFO
# Comma-separated allow-list, or * for any origin
CORS_ALLOW_ORIGINS=*
# true  = serve the browser playground at / (it spends model allowance like the API
#         does; with OPENROUTER_MODELS blank, a visitor can also start a test of the
#         free models from it)
# false = API only
PLAYGROUND_ENABLED=true
# true  = at startup, when a key is set, ask OpenRouter whether each configured model
#         is still listed, and log the answer. The lookup itself sends no key, and
#         it never changes which models are called.
# false = start without that request and without reading the published list, for
#         example when working offline. The published list is then read after the
#         first request that fails.
MODEL_CATALOGUE_CHECK=true

# --- OpenRouter attribution (optional, shown on openrouter.ai dashboards) --
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=invoice-extraction-service
