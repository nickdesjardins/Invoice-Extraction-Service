# --- Provider credentials -------------------------------------------------
# OpenRouter is the only vendor this service talks to. https://openrouter.ai/keys
# Leave blank to disable the service; /health then reports "unavailable".
OPENROUTER_API_KEY=

# --- Model chain ----------------------------------------------------------
# Ordered, comma-separated. The first entry is the primary; each later entry is
# tried only when the earlier ones fail. All defaults are :free, so a request
# normally costs nothing and a fallback costs nothing either.
# Benchmarked over six invoice cases (see README):
#   nex-n2.5-mini  29/31, 0 errors, ~4.5s   <- fastest reliable
#   lfm-2.5-2.6b   30/31, 0 errors, ~5.6s   <- different provider, real diversity
#   nex-n2.5-pro   31/31, 0 errors, ~12.3s  <- most accurate, slowest
OPENROUTER_MODELS=nex-agi/nex-n2.5-mini:free,liquid/lfm-2.5-2.6b:free,nex-agi/nex-n2.5-pro:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# true  = strict json_schema response_format (needs a structured-output model)
# false = plain JSON mode with the schema embedded in the system prompt
OPENROUTER_STRICT_JSON_SCHEMA=true
MAX_OUTPUT_TOKENS=2048

# --- Service --------------------------------------------------------------
# development | staging | production | test  (production also hides /docs)
ENVIRONMENT=development
# Per-model wall-clock budget in seconds.
# Worst case latency ~= TIMEOUT_SECONDS x number of models in the chain.
TIMEOUT_SECONDS=30
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated allow-list, or * for any origin
CORS_ALLOW_ORIGINS=*

# --- OpenRouter attribution (optional, shown on openrouter.ai dashboards) --
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=invoice-extraction-service
